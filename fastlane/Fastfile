# Fastfile configuration for happyFamily iOS Project
# Architecture: XcodeGen + SwiftUI + Multiple Configs (Debug, Staging, Release)

require "base64"
require "fileutils"
require "securerandom"
require "shellwords"
require_relative "lib/backend_release_guard"

default_platform(:ios)

platform :ios do

  # ----------------------------------------------------------------------
  # Helpers
  # ----------------------------------------------------------------------
  def load_api_key
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"] || "VQHBTPG3DZ"
    key_file = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || File.expand_path("../AuthKey_#{key_id}.p8", __dir__)

    UI.user_error!("App Store Connect API key file was not found at #{key_file}") unless File.file?(key_file)
    ENV["APP_STORE_CONNECT_API_KEY_PATH"] = key_file

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: key_file,
      in_house: false
    )
  end

  def automatic_signing_xcargs
    key_file = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]

    UI.user_error!("App Store Connect signing credentials are incomplete") if [key_file, key_id, issuer_id].any? { |value| value.to_s.empty? }

    [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{Shellwords.escape(key_file)}",
      "-authenticationKeyID #{Shellwords.escape(key_id)}",
      "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
    ].join(" ")
  end

  def run_testflight_release(lane, options)
    root = File.expand_path("..", __dir__)
    expected = BackendReleaseGuard.expected(lane)
    number = BackendReleaseGuard.build_number(options[:build_number])
    BackendReleaseGuard.verify_backend(expected)
    BackendReleaseGuard.verify_build_settings(expected, number, root: root)

    # Fail backend preflight before importing any signing credentials.
    import_ci_signing_assets
    api_key = load_api_key
    signing_xcargs = automatic_signing_xcargs
    FileUtils.mkdir_p(File.join(root, "build"))
    output = Dir.mktmpdir("testflight-#{lane}-", File.join(root, "build"))
    archive = File.join(output, "happyFamily.xcarchive")
    ipa = build_app(
      project: "happyFamily.xcodeproj",
      scheme: "happyFamily",
      configuration: expected.configuration,
      export_method: "app-store",
      clean: true,
      archive_path: archive,
      output_directory: output,
      output_name: "happyFamily.ipa",
      # gym also forwards xcargs to export. Do not duplicate signing arguments.
      xcargs: "CURRENT_PROJECT_VERSION=#{number} #{signing_xcargs}"
    )
    BackendReleaseGuard.upload_validated(
      archive: archive, ipa: ipa, expected: expected, number: number, output_directory: output
    ) do |validated_ipa|
      upload_to_testflight(
        ipa: validated_ipa,
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        distribute_external: lane == "beta" && (options[:distribute_external] || false),
        notify_external_testers: false
      )
    end
  rescue BackendReleaseGuard::Error => error
    UI.user_error!(error.message)
  end

  # GitHub-hosted runners have no signing identities, and the Release
  # configuration signs manually with the pinned "happyFamily App Store
  # Associated Domains" profile. The workflow passes the Apple Distribution
  # certificate (.p12) and that profile as base64 secrets; decode them and
  # import into a fresh keychain so manual signing can find them.
  def import_ci_signing_assets
    cert_b64 = ENV["APPLE_CERTIFICATE_BASE64"].to_s
    cert_password = ENV["APPLE_CERTIFICATE_PASSWORD"].to_s
    profile_b64 = ENV["PROVISIONING_PROFILE_BASE64"].to_s

    if cert_b64.empty?
      UI.user_error!("No signing certificate available. Set the APPLE_CERTIFICATE_BASE64 secret to the Apple Distribution .p12 for team K39QVFTK2A (and APPLE_CERTIFICATE_PASSWORD to its export password).")
    end
    if cert_password.empty?
      UI.user_error!("No signing certificate password available. Set the APPLE_CERTIFICATE_PASSWORD secret to the password used when exporting the Apple Distribution .p12.")
    end
    if profile_b64.empty?
      UI.user_error!("No provisioning profile available. Set the PROVISIONING_PROFILE_BASE64 secret to the 'happyFamily App Store Associated Domains 2026-09-01' profile from the Developer portal.")
    end

    keychain_name = "happyfamily-ci.keychain"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_password = ENV["KEYCHAIN_PASSWORD"].to_s.empty? ? SecureRandom.base64(24) : ENV["KEYCHAIN_PASSWORD"]

    # `security create-keychain` adds `-db`, so use the base name above to
    # create exactly ~/Library/Keychains/happyfamily-ci.keychain-db.
    delete_keychain(keychain_path: keychain_path) if File.exist?(keychain_path)

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 0
    )

    cert_path = File.join(Dir.tmpdir, "happyfamily-distribution.p12")
    File.binwrite(cert_path, Base64.decode64(cert_b64))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: cert_password,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    profile_path = File.join(Dir.tmpdir, "happyfamily-appstore.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(profile_b64))
    profile_plist = sh("security cms -D -i #{profile_path.shellescape}", log: false)
    uuid = profile_plist[/UUID<\/key>\s*<string>([A-Fa-f0-9-]+)<\/string>/, 1]
    profile_name = profile_plist[/<key>Name<\/key>\s*<string>([^<]+)<\/string>/, 1]
    UI.user_error!("PROVISIONING_PROFILE_BASE64 is not a valid .mobileprovision") if uuid.to_s.empty?
    UI.user_error!("PROVISIONING_PROFILE_BASE64 must contain the profile named 'happyFamily App Store Associated Domains 2026-09-01', but found '#{profile_name}'.") unless profile_name == "happyFamily App Store Associated Domains 2026-09-01"

    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profiles_dir)
    FileUtils.cp(profile_path, File.join(profiles_dir, "#{uuid}.mobileprovision"))
    UI.success("Installed provisioning profile '#{profile_name}' (#{uuid})")
  end

  # ----------------------------------------------------------------------
  # Hooks
  # ----------------------------------------------------------------------
  before_all do
    # Ensure the Xcode project is generated and up to date from project.yml
    sh("cd .. && xcodegen generate")
  end

  # ----------------------------------------------------------------------
  # Code Quality & Formatting Lanes
  # ----------------------------------------------------------------------
  desc "Run SwiftFormat and SwiftLint checks"
  lane :lint do
    sh("cd .. && swiftformat --lint .")
    swiftlint(
      mode: :lint,
      strict: false,
      config_file: ".swiftlint.yml"
    )
  end

  desc "Automatically format and autocorrect code with SwiftFormat and SwiftLint"
  lane :format do
    sh("cd .. && swiftformat .")
    swiftlint(
      mode: :autocorrect,
      config_file: ".swiftlint.yml"
    )
  end

  # ----------------------------------------------------------------------
  # Testing Lane
  # ----------------------------------------------------------------------
  desc "Run Unit and UI tests"
  lane :test do
    run_tests(
      project: "happyFamily.xcodeproj",
      scheme: "happyFamily",
      devices: ["iPhone 16"],
      clean: true
    )
  end

  # ----------------------------------------------------------------------
  # Build Lanes (Local / CI)
  # ----------------------------------------------------------------------
  desc "Build Debug app for simulator"
  lane :build_debug do
    build_app(
      project: "happyFamily.xcodeproj",
      scheme: "happyFamily",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      skip_package_ipa: true,
      skip_codesigning: true
    )
  end

  desc "Build Staging archive (.ipa)"
  lane :build_staging do
    build_app(
      project: "happyFamily.xcodeproj",
      scheme: "happyFamily",
      configuration: "Staging",
      export_method: "ad-hoc",
      clean: true,
      output_directory: "./build/Staging"
    )
  end

  desc "Build Release archive (.ipa) for App Store / TestFlight"
  lane :build_release do
    build_app(
      project: "happyFamily.xcodeproj",
      scheme: "happyFamily",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build/Release"
    )
  end

  # ----------------------------------------------------------------------
  # Distribution & Deployment Lanes
  # ----------------------------------------------------------------------
  desc "Build and upload Beta build to TestFlight"
  lane :beta do |options|
    run_testflight_release("beta", options)
  end

  desc "Build and upload Staging build to TestFlight"
  lane :staging_beta do |options|
    run_testflight_release("staging_beta", options)
  end

  desc "Build and deploy a new version to the App Store"
  lane :release do |options|
    api_key = load_api_key

    build_app(
      project: "happyFamily.xcodeproj",
      scheme: "happyFamily",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build/AppStore"
    )

    upload_to_app_store(
      api_key: api_key,
      force: true,
      skip_screenshots: true,
      skip_metadata: false
    )
  end

end
