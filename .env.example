# ==============================================================================
# Apple Developer & App Store Connect Configuration (Example Template)
# ==============================================================================

# App Store Connect API Key
APP_STORE_CONNECT_KEY_ID=your_key_id_here
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id_here
APP_STORE_CONNECT_KEY_FILEPATH=./AuthKey_your_key_id.p8
# APP_STORE_CONNECT_API_KEY_KEY=

# Apple Developer Account Details
APPLE_ID=your_apple_id_email@example.com
ITC_TEAM_ID=your_itc_team_id
TEAM_ID=your_team_id

# App Identifiers
APP_IDENTIFIER=com.academy.hendraaaa.happyFamily
APP_IDENTIFIER_STAGING=com.academy.hendraaaa.happyFamily.staging
APP_IDENTIFIER_DEBUG=com.academy.hendraaaa.happyFamily.debug

# Fastlane Settings
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_ITC_TEAM_ID=your_itc_team_id
