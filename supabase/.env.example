# Copy to supabase/.env.local. Never commit real values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-key
PII_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
PII_ENCRYPTION_KEYS_JSON='{"1":"replace-with-32-byte-base64-key"}'
PII_HMAC_KEY_BASE64=replace-with-32-byte-base64-key
DONOR_ACCESS_SIGNING_KEY_BASE64=replace-with-32-byte-base64-key
TOKEN_KEY_VERSION=1
APP_ENVIRONMENT=local
APP_CLIP_BASE_URL=https://example.com/kumpul
PUBLIC_BOOKING_ENABLED=true
BANNER_CLEANUP_SECRET=replace-with-random-32-byte-secret
PROFILE_MEDIA_CLEANUP_SECRET=replace-with-random-32-byte-secret
