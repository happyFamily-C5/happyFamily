//
// Debug.xcconfig
// Configuration settings for Debug builds
//

#include "Base.xcconfig"

// App & Bundle Info (Debug overrides)
APP_DISPLAY_NAME = happyFamily (Debug)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).happyFamily.debug

// Compilation & Optimization
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_COMPILATION_MODE = singlefile
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)

// Debug deliberately uses the hosted staging project. Put its public URL and
// publishable key in Config/Secrets.xcconfig; never run a local Docker stack.
KUMPUL_BACKEND_URL = $(KUMPUL_STAGING_BACKEND_URL)
KUMPUL_BACKEND_PUBLISHABLE_KEY = $(KUMPUL_STAGING_PUBLISHABLE_KEY)
KUMPUL_BACKEND_ENVIRONMENT = staging

// Debugging & Testing
ENABLE_TESTABILITY = YES
ONLY_ACTIVE_ARCH = YES
DEBUG_INFORMATION_FORMAT = dwarf
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
