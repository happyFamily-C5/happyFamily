// Copy this file to Secrets.xcconfig. The copied file is ignored by Git.
// Only publishable client keys belong here. Never add a secret/service-role key.

KUMPUL_LOCAL_PUBLISHABLE_KEY = replace-with-local-publishable-key
KUMPUL_STAGING_BACKEND_URL = https:/$()/replace-with-staging-project.supabase.co
KUMPUL_STAGING_PUBLISHABLE_KEY = replace-with-staging-publishable-key
KUMPUL_PRODUCTION_BACKEND_URL = https:/$()/replace-with-production-project.supabase.co
KUMPUL_PRODUCTION_PUBLISHABLE_KEY = replace-with-production-publishable-key
